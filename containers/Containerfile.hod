# HOD stack (HOD_PYTHON): the CSMF halo-model fit of analyses/csmf.
#   HOD_NRV (github.com/rpaviot/NRV_HOD, tag unions-desi-ia-paper = ed475bb, editable as
#   `nrvpy`) with jax, the Dark Emulator (beta^NL non-linear halo bias), pyccl, iminuit and
#   nautilus. Kept separate from the IA stack because of the jax / dark_emulator pins.
# Local equivalent on the analysis cluster: ~/NRV_HOD/.venv_hod (Python 3.12.8, jax 0.10.1,
# dark_emulator 1.1.2, pyccl 3.3.4, iminuit 2.32.0, nautilus-sampler 1.0.6).
FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential gfortran git libgsl-dev libfftw3-dev cmake pkg-config \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
RUN pip install --no-cache-dir "numpy==2.4.6" "scipy==1.17.1" "pandas==3.0.3" \
        "jax==0.10.1" "jaxlib==0.10.1" "pyccl==3.3.4" "camb==1.6.6" \
        "iminuit>=2.32" "nautilus-sampler==1.0.6" "dark_emulator==1.1.2" \
        "matplotlib>=3.10" "pyyaml>=6.0" "h5py>=3.13" "scikit-learn>=1.6" \
    && pip install --no-cache-dir \
        "git+https://github.com/rpaviot/NRV_HOD.git@unions-desi-ia-paper"

COPY . .
ENV HOD_PYTHON=python
